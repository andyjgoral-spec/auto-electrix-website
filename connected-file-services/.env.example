# Copy to .env and edit. Never commit the real .env file.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://cfs:cfs@localhost:5432/cfs
# Private file storage (outside any public web folder)
STORAGE_DIR=./storage
# Stripe (test keys from https://dashboard.stripe.com/test/apikeys).
# Leave blank to use the built-in demo checkout instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public URL of the app, used for Stripe redirect links
APP_BASE_URL=http://localhost:5000
# Set to 1 when served over HTTPS
SESSION_COOKIE_SECURE=0
# Optional email (otherwise emails are printed to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=files@connected-automotive.example
# Seller details printed on invoices
SELLER_NAME=Connected Automotive Technologies
SELLER_ADDRESS=Address not configured
SELLER_VAT_NUMBER=Not configured
